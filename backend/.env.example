# Upstash Redis or local Redis connection URL
REDIS_URL="rediss://default:your_password@your_endpoint.upstash.io:6379"

# Server port (defaults to 3001 or provided by host)
PORT=3001

# LiveKit Cloud credentials for voice chat token issuance (required for voice chat).
# Get these from your LiveKit Cloud project settings. Never commit real values.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
